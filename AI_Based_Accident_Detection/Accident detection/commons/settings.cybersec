  <securityAttributes xmi:id="_sNvNcM8CEemOvMGPpWSWoA" mediniIdentifier="_sNvNcM8CEemOvMGPpWSWoA" name="Authenticity" description="The property that an entity is what it claims to be" source="CIAA / HEAVENS "/>
