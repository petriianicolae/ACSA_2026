  <securityAttributes xmi:id="_VLY3sM74EemH8PpOxVZSBg" mediniIdentifier="_VLY3sM74EemH8PpOxVZSBg" name="Confidentiality" description="Absence of unauthorized disclosure of information" source="CIA Triad / HEAVENS"/>
  <securityAttributes xmi:id="_l4NOwM8CEemOvMGPpWSWoA" mediniIdentifier="_l4NOwM8CEemOvMGPpWSWoA" name="Integrity" description="Absence of improper system alternations" source="CIA Triad / HEAVENS"/>
