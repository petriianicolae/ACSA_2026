  <securityAttributes xmi:id="_MdwBsNYVEemme5in8-9nig" mediniIdentifier="_MdwBsNYVEemme5in8-9nig" name="Non-Repudiation" description="The ability to prove the occurrence of a claimed event or action and its originating entities" source="HEAVENS"/>
